      <div class="about-tags">
        <div class="about-tag">🧼 Bathing Soaps</div>
        <div class="about-tag">🫧 Handwash</div>
        <div class="about-tag">👕 Washing Soaps</div>
        <div class="about-tag">🧹 Floor Cleaners</div>
        <div class="about-tag">🌸 Air Fresheners</div>
        <div class="about-tag">🧪 Powders & Surf</div>
      </div>
    </div>
  </div>
</section>

<!-- PRODUCTS -->
<section id="products" class="products-section">
  <div class="sec-header reveal">
    <p class="eyebrow">What We Offer</p>
    <h2 class="sec-title">Our Product Range</h2>
  </div>
  <div class="filter-bar reveal">
    <button class="filter-btn active" onclick="filterP('all',this)">All</button>
    <button class="filter-btn" onclick="filterP('bathing',this)">🧼 Bathing Soaps</button>
    <button class="filter-btn" onclick="filterP('washing',this)">👕 Washing Soaps</button>
    <button class="filter-btn" onclick="filterP('handwash',this)">🫧 Handwash</button>
    <button class="filter-btn" onclick="filterP('liquids',this)">🧴 Liquids</button>
    <button class="filter-btn" onclick="filterP('fresheners',this)">🌸 Air Fresheners</button>
    <button class="filter-btn" onclick="filterP('powder',this)">🧪 Powders</button>
  </div>
  <div class="products-grid" id="pg">

    <div class="pcard reveal" data-cat="bathing">
      <img class="pcard-img" src="data:image/png;base64,
